# Template for the two gitignored secret files that feed `secretGenerator`:
#
#   k8s/base/.env.secrets   -> used by the dev overlay
#   k8s/prod/.env.secrets   -> replaces it in the prod overlay
#
#   cp k8s/base/.env.example k8s/base/.env.secrets
#   cp k8s/base/.env.example k8s/prod/.env.secrets
#   # fill in real values, then apply the overlay
#
# Each file must be a copy, not a shared one: kustomize will not read a file
# above its own kustomization root, and `kubectl apply -k` has no
# --load-restrictor escape hatch.
#
# This file documents WHICH keys are required. The values below are fake.
# Everything else the services need is a non-secret and lives in the
# configMapGenerator blocks in base/ and the overlays.
#
# The secret is consumed by: api, transcoder-worker, grafana, and the
# migration Job in k8s/migration. All five keys are required in production —
# api/worker hard-fail on boot if one is missing (see common/env.util.ts),
# rather than silently falling back to the LocalStack defaults.

# DigitalOcean Managed Postgres. Take the connection string from the DO panel;
# prefer the VPC-private host and keep ?sslmode=require.
# Read by PrismaService and by `prisma migrate deploy` in the migration Job.
DATABASE_URL=postgresql://user:password@private-db-host:25060/watchly?schema=public&sslmode=require

# AWS IAM key scoped to the two buckets and the one SQS queue — not a
# general-purpose key. The same credentials serve S3 and SQS: s3.config.ts
# feeds both clients from these two variables.
S3_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
S3_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY

# Managed Redis. The password is obviously a secret; the host is here for the
# same reason DATABASE_URL is — it names your infrastructure, and it would
# otherwise be the one value in the overlays that cannot be committed.
# Port and TLS stay in the manifests: neither is sensitive.
#
# Prefer the VPC-private host from the DO panel. The username is `default`,
# so only the password is needed.
REDIS_HOST=private-redis-do-user-0-0.b.db.ondigitalocean.com
REDIS_PASSWORD=redis-password-from-the-do-panel

# Injected into the Grafana Deployment as GF_SECURITY_ADMIN_PASSWORD. Grafana
# is reachable from the internet through the Ingress, so this is the only
# thing standing in front of it — make it long.
GRAFANA_ADMIN_PASSWORD=a-long-random-password
