# Template for k8s/home/.env.secrets (gitignored), read by the overlay's
# secretGenerator:
#
#   cp k8s/home/.env.example k8s/home/.env.secrets
#   # fill in real values, then apply the overlay
#
# Unlike dev and prod, nothing here points at a managed service: Postgres,
# Redis and MinIO all run in this namespace and read these same values, so a
# password changed here has to be followed by deleting that component's PVC
# or changing the password inside it — the containers only read it when they
# initialise an empty volume.

# Consumed by the api, the worker and the migration Job. Host and database
# name come from postgres.yaml; only the password is yours to pick.
# No sslmode: the connection never leaves the cluster network.
DATABASE_URL=postgresql://watchly:CHANGE_ME@postgres:5432/watchly?schema=public

# The same value postgres.yaml feeds to POSTGRES_PASSWORD. Keep the two in
# step — they are one password written twice because Prisma wants a URL and
# the image wants a variable.
POSTGRES_PASSWORD=CHANGE_ME

# MinIO's root credentials. The api authenticates with these, and minio.yaml
# starts the server with them. Access key must be at least 3 characters, the
# secret at least 8.
S3_ACCESS_KEY_ID=watchly
S3_SECRET_ACCESS_KEY=CHANGE_ME_at_least_8_chars

# In-cluster Redis. The host is the service name; the password is what
# redis.yaml passes to --requirepass.
REDIS_HOST=redis
REDIS_PASSWORD=CHANGE_ME

# Grafana is not exposed through the Ingress — reach it with
# `kubectl port-forward svc/grafana 3001:3000 -n watchly-home`.
GRAFANA_ADMIN_PASSWORD=CHANGE_ME
