{
  "name": "watchly",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@10.30.0",
  "scripts": {
    "commitlint": "commitlint",
    "docker:dev": "docker compose --project-name watchly -f ./config/dev/docker-compose.yml",
    "dev:up": "pnpm docker:dev up -d",
    "dev:down": "pnpm docker:dev down",
    "dev:build": "pnpm docker:dev build",
    "docker:build:api": "docker build -f apps/api/Dockerfile --target runner -t watchly-api .",
    "docker:build:worker": "docker build -f apps/api/Dockerfile --target worker-runner -t watchly-transcoder-worker .",
    "docker:build:migrator": "docker build -f apps/api/Dockerfile --target migrator -t watchly-migrator .",
    "docker:build:client": "docker build -f apps/client/Dockerfile --target runner -t watchly-client --build-arg BACKEND_API_URL=${BACKEND_API_URL:-http://api:3000} --build-arg NEXT_PUBLIC_BACKEND_API_URL=${NEXT_PUBLIC_BACKEND_API_URL:-http://localhost:3000} --build-arg NEXT_PUBLIC_APP_URL=${NEXT_PUBLIC_APP_URL:-http://localhost:4000} --build-arg NEXT_PUBLIC_REMOTE_IMAGE_HOSTNAME=${NEXT_PUBLIC_REMOTE_IMAGE_HOSTNAME:-m.media-amazon.com} --build-arg NEXT_PUBLIC_S3_IMAGE_PORT=${NEXT_PUBLIC_S3_IMAGE_PORT:-4000} .",
    "docker:build": "pnpm docker:build:api && pnpm docker:build:worker && pnpm docker:build:migrator && pnpm docker:build:client",
    "lint:api": "pnpm --filter api precommit",
    "lint:client": "pnpm --filter client precommit",
    "lint": "pnpm lint:api && pnpm lint:client",
    "prepare": "husky || true"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.3.0",
    "@commitlint/config-conventional": "^20.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2"
  }
}
