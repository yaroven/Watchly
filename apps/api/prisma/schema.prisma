generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  USER
}

enum AgeRating {
  AGE_0
  AGE_12
  AGE_16
  AGE_18
}

enum TitleType {
  MOVIE
  SERIES
}

enum TranscodingStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum ExternalRatingSource {
  IMDB
  METACRITIC
  ROTTEN_TOMATOES
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  role      Role     @default(USER)
  createdAt DateTime @default(now())

  // Shown next to anything the user writes. Nullable because every account
  // that already exists predates them; the api falls back to the email local
  // part until the user sets one.
  displayName String?

  /// Object key in the processed bucket, not a URL. A URL would bake the host
  /// and — if it were presigned — an expiry into the row; the API builds one
  /// when it serialises the user. Null until an avatar finishes processing.
  avatarKey String?

  ratings        TitleRating[]
  comments       TitleComment[]
  reactions      CommentReaction[]
  reports        CommentReport[]
  titleReactions TitleReaction[]
  watchlist      WatchlistItem[]
}

model Title {
  id                String            @id @default(uuid())
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  name              String
  description       String
  type              TitleType
  /// Object key in the processed bucket, not a URL. A presigned URL stored in a
  /// row outlives its own expiry; the URL is derived on read.
  posterKey         String?
  ageRating         AgeRating
  country           String
  releaseDate       DateTime
  language          String
  trailerUrl        String
  runtime           Int
  network           String
  director          String
  closedCaption     Boolean
  transcodingStatus TranscodingStatus @default(PENDING)
  externalRatings   ExternalRatings[]
  externalIds       TitleExternalId[]

  videoTranscodingProgress VideoTranscodingProgress?

  seasons          Season[]
  castCredits      CastCredit[]
  genres           Genre[]
  ratings          TitleRating[]
  comments         TitleComment[]
  reactions        TitleReaction[]
  watchlistEntries WatchlistItem[]

  @@index([type, transcodingStatus])
}

/// A thumbs up or down on the title itself, distinct from TitleRating: the
/// score says how good it is, this says whether the viewer enjoyed it.
model TitleReaction {
  id        String       @id @default(uuid())
  titleId   String
  title     Title        @relation(fields: [titleId], references: [id], onDelete: Cascade)
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      ReactionType
  createdAt DateTime     @default(now())

  // One vote per person; switching sides updates this row rather than adding one.
  @@unique([titleId, userId])
  @@index([titleId, type])
}

model WatchlistItem {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  titleId   String
  title     Title    @relation(fields: [titleId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, titleId])
  // The watchlist page reads one user's rows newest first.
  @@index([userId, createdAt])
  @@index([titleId])
}

/// A viewer's score for a title, independent of whether they wrote anything.
/// Kept apart from TitleComment on purpose: a score is one opinion per person
/// that changes over time, a comment is many entries that do not.
model TitleRating {
  id        String   @id @default(uuid())
  titleId   String
  title     Title    @relation(fields: [titleId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  score     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([titleId, userId])
}

/// One level of threading: a comment either belongs to a title (parentId null)
/// or replies to one that does. The service rejects a reply to a reply — the
/// column allows deeper trees so the rule can be relaxed without a migration.
model TitleComment {
  id         String   @id @default(uuid())
  titleId    String
  title      Title    @relation(fields: [titleId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  text       String
  hasSpoiler Boolean  @default(false)
  createdAt  DateTime @default(now())

  parentId String?
  parent   TitleComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  TitleComment[] @relation("CommentReplies")

  reactions CommentReaction[]
  reports   CommentReport[]

  @@index([titleId, parentId, createdAt])
}

model CommentReaction {
  id        String       @id @default(uuid())
  commentId String
  comment   TitleComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      ReactionType
  createdAt DateTime     @default(now())

  // One vote per person; switching sides updates this row rather than adding one.
  @@unique([commentId, userId])
  @@index([commentId, type])
}

enum ReactionType {
  LIKE
  DISLIKE
}

model CommentReport {
  id        String       @id @default(uuid())
  commentId String
  comment   TitleComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  reason    String?
  createdAt DateTime     @default(now())

  @@unique([commentId, userId])
}

model ExternalRatings {
  id         String               @id @default(uuid())
  titleId    String
  title      Title                @relation(fields: [titleId], references: [id], onDelete: Cascade)
  source     ExternalRatingSource
  rating     Float
  // Only IMDB exposes a vote count through OMDb; Rotten Tomatoes and
  // Metacritic ratings are stored with this left null.
  votesCount Int?
  updatedAt  DateTime             @updatedAt

  @@unique([titleId, source])
}

model TitleExternalId {
  id         String               @id @default(uuid())
  titleId    String
  title      Title                @relation(fields: [titleId], references: [id], onDelete: Cascade)
  source     ExternalRatingSource
  externalId String

  @@unique([titleId, source])
  @@unique([source, externalId])
}

model Genre {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  name      String   @unique

  titles Title[]
}

model Artist {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  name      String
  /// Object key in the processed bucket, not a URL. See Title.posterKey.
  photoKey  String?

  castCredits CastCredit[]
}

model CastCredit {
  id        String  @id @default(uuid())
  titleId   String
  title     Title   @relation(fields: [titleId], references: [id], onDelete: Cascade)
  artistId  String
  artist    Artist  @relation(fields: [artistId], references: [id], onDelete: Cascade)
  character String?
  order     Int     @default(0)

  @@unique([titleId, artistId])
  @@index([artistId])
}

model VideoTranscodingProgress {
  id                 String   @id @default(uuid())
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  progressPercentage Int      @default(0)

  titleId String? @unique
  title   Title?  @relation(fields: [titleId], references: [id], onDelete: Cascade)

  episodeId String?  @unique
  episode   Episode? @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@index([titleId])
  @@index([episodeId])
}

model Season {
  id          String    @id @default(uuid())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  number      Int
  name        String
  description String
  /// Object key in the processed bucket, not a URL. See Title.posterKey.
  posterKey   String?
  titleId     String
  title       Title     @relation(fields: [titleId], references: [id], onDelete: Cascade)
  episodes    Episode[]

  @@unique([titleId, number])
}

model Episode {
  id                String            @id @default(uuid())
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  number            Int
  name              String
  description       String
  seasonId          String
  season            Season            @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  transcodingStatus TranscodingStatus @default(PENDING)

  videoTranscodingProgress VideoTranscodingProgress?

  @@unique([seasonId, number])
}
