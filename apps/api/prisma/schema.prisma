generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  USER
}

enum AgeRating {
  AGE_0
  AGE_12
  AGE_16
  AGE_18
}

enum TitleType {
  MOVIE
  SERIES
}

enum TranscodingStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum ExternalRatingSource {
  IMDB
  METACRITIC
  ROTTEN_TOMATOES
}

model User {
  id          String   @id @default(uuid())
  email       String   @unique
  password    String
  role        Role     @default(USER)
  createdAt   DateTime @default(now())
  displayName String?
  avatarKey   String?

  ratings   TitleRating[]
  comments  Comment[]
  reactions Reaction[]
  reports   Report[]
  watchlist WatchlistItem[]
}

model Title {
  id                String            @id @default(uuid())
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  name              String
  description       String
  type              TitleType
  posterKey         String?
  ageRating         AgeRating
  country           String
  releaseDate       DateTime
  language          String
  trailerUrl        String
  runtime           Int
  network           String
  director          String
  closedCaption     Boolean
  transcodingStatus TranscodingStatus @default(PENDING)
  externalRatings   ExternalRatings[]
  externalIds       TitleExternalId[]

  videoTranscodingProgress VideoTranscodingProgress?

  seasons          Season[]
  castCredits      CastCredit[]
  genres           Genre[]
  ratings          TitleRating[]
  watchlistEntries WatchlistItem[]
  engagement       TitleEngagement?
  comments         Comment[]
  reactions        Reaction[]
  counters         EngagementCounters?

  @@index([type, transcodingStatus])
}

model TitleEngagement {
  titleId        String @id
  title          Title  @relation(fields: [titleId], references: [id], onDelete: Cascade)
  avgScore       Float?
  ratingCount    Int    @default(0)
  watchlistCount Int    @default(0)
}

model EngagementCounters {
  id           String @id @default(uuid())
  likes        Int    @default(0)
  dislikes     Int    @default(0)
  commentCount Int    @default(0)

  titleId String? @unique
  title   Title?  @relation(fields: [titleId], references: [id], onDelete: Cascade)

  commentId String?  @unique
  comment   Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
}

model Reaction {
  id        String       @id @default(uuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      ReactionType
  createdAt DateTime     @default(now())

  titleId String?
  title   Title?  @relation(fields: [titleId], references: [id], onDelete: Cascade)

  commentId String?
  comment   Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([titleId, userId])
  @@unique([commentId, userId])
  @@index([titleId, type])
  @@index([commentId, type])
}

model WatchlistItem {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  titleId   String
  title     Title    @relation(fields: [titleId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, titleId])
  @@index([userId, createdAt])
  @@index([titleId])
}

model TitleRating {
  id        String   @id @default(uuid())
  titleId   String
  title     Title    @relation(fields: [titleId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  score     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([titleId, userId])
}

model Comment {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  text       String
  hasSpoiler Boolean  @default(false)
  createdAt  DateTime @default(now())

  titleId String?
  title   Title?  @relation(fields: [titleId], references: [id], onDelete: Cascade)

  parentId String?
  parent   Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  Comment[] @relation("CommentReplies")

  reports   Report[]
  reactions Reaction[]
  counters  EngagementCounters?

  @@index([titleId, createdAt])
  @@index([parentId, createdAt])
}

enum ReactionType {
  LIKE
  DISLIKE
}

model Report {
  id        String   @id @default(uuid())
  commentId String
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reason    String?
  createdAt DateTime @default(now())

  @@unique([commentId, userId])
  @@index([commentId, createdAt])
}

model ExternalRatings {
  id         String               @id @default(uuid())
  titleId    String
  title      Title                @relation(fields: [titleId], references: [id], onDelete: Cascade)
  source     ExternalRatingSource
  rating     Float
  votesCount Int?
  updatedAt  DateTime             @updatedAt

  @@unique([titleId, source])
}

model TitleExternalId {
  id         String               @id @default(uuid())
  titleId    String
  title      Title                @relation(fields: [titleId], references: [id], onDelete: Cascade)
  source     ExternalRatingSource
  externalId String

  @@unique([titleId, source])
  @@unique([source, externalId])
}

model Genre {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  name      String   @unique

  titles Title[]
}

model Artist {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  name      String
  photoKey  String?

  castCredits CastCredit[]
}

model CastCredit {
  id        String  @id @default(uuid())
  titleId   String
  title     Title   @relation(fields: [titleId], references: [id], onDelete: Cascade)
  artistId  String
  artist    Artist  @relation(fields: [artistId], references: [id], onDelete: Cascade)
  character String?
  order     Int     @default(0)

  @@unique([titleId, artistId])
  @@index([artistId])
}

model VideoTranscodingProgress {
  id                 String   @id @default(uuid())
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  progressPercentage Int      @default(0)

  titleId String? @unique
  title   Title?  @relation(fields: [titleId], references: [id], onDelete: Cascade)

  episodeId String?  @unique
  episode   Episode? @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@index([titleId])
  @@index([episodeId])
}

model Season {
  id          String    @id @default(uuid())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  number      Int
  name        String
  description String
  posterKey   String?
  titleId     String
  title       Title     @relation(fields: [titleId], references: [id], onDelete: Cascade)
  episodes    Episode[]

  @@unique([titleId, number])
}

model Episode {
  id                String            @id @default(uuid())
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  number            Int
  name              String
  description       String
  seasonId          String
  season            Season            @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  transcodingStatus TranscodingStatus @default(PENDING)

  videoTranscodingProgress VideoTranscodingProgress?

  @@unique([seasonId, number])
}
